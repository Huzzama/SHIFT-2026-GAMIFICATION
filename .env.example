# FARO extension build configuration (Vite reads VITE_* at build time).
# Copy to .env.local to change locally; .env.local is git-ignored.

# mock  -> the prototype: fixtures answer, no backend needed (default)
# http  -> the real thing: calls the FARO backend, which talks to Canvas
VITE_CANVAS_MODE=mock

# Where the FARO backend listens (see server/.env.example). No trailing slash.
VITE_FARO_API_URL=http://127.0.0.1:3000

# There is no Canvas token here and there must never be one. The token lives
# in server/.env, on the machine that runs the backend.
