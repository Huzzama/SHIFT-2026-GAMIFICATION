# FARO backend configuration. Copy to server/.env and fill in.
# server/.env is git-ignored. Never commit a real token.

# Canvas and the mentor are both optional, but at least one must be set.
# Leave CANVAS_API_URL and CANVAS_ACCESS_TOKEN empty to run the mentor only
# (the extension then stays in mock Canvas mode).

# Your Canvas instance, no trailing slash.
#   Free-for-Teacher: https://canvas.instructure.com
#   Institution:      https://<institution>.instructure.com
CANVAS_API_URL=

# Personal access token of the STUDENT account FARO opens for.
# Canvas -> Account -> Settings -> Approved Integrations -> "+ New Access Token".
# Lives only in this file and in the server's memory. Never in the extension.
CANVAS_ACCESS_TOKEN=

# Optional. Which course FARO opens. If omitted, the student's first active
# enrollment is used.
# FARO_COURSE_ID=

# Where the server listens. Keep 127.0.0.1 unless you are deploying behind TLS.
FARO_HOST=127.0.0.1
FARO_PORT=3000

# Browser origins allowed to call this server (comma-separated).
# Add your extension id once loaded: chrome-extension://<id>
FARO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Requests per minute per client before 429.
FARO_RATE_LIMIT_PER_MINUTE=120

# Seconds before a Canvas call is abandoned (milliseconds).
FARO_CANVAS_TIMEOUT_MS=10000

# info | debug
FARO_LOG_LEVEL=info

# ---------------------------------------------------------------- mentor (Gemini)
# Optional. With a key, POST /api/mentor answers with Gemini; without one the
# extension keeps using its local mentor. Get a key at https://aistudio.google.com
# Lives only in this file and in the server's memory. Never in the extension.
GEMINI_API_KEY=

# Model code. Check https://ai.google.dev/gemini-api/docs/models for current names.
GEMINI_MODEL=gemini-3.5-flash

# Milliseconds before a Gemini call is abandoned.
GEMINI_TIMEOUT_MS=20000

# Mentor calls per minute per client (cost control, on top of the global limit).
FARO_MENTOR_PER_MINUTE=20
